# Required
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:5173
ENVIRONMENT=development

# Optional: Google sign-in (Google Cloud Console > Credentials > OAuth client ID, Web application)
# Authorized redirect URI: http://localhost:5173/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: magic-link emails via Resend (https://resend.com). Without a key in development,
# the sign-in link is printed to the dev server log instead.
RESEND_API_KEY=
MAIL_FROM=TaskFlow <onboarding@resend.dev>

# Optional: Cloudflare Turnstile (bot protection on sign-up and magic-link requests).
# Test keys below always pass; production uses the real widget keys (site key in wrangler.jsonc, secret via wrangler secret).
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
